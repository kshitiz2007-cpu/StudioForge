# Runtime execution is intentionally disabled until a provider is configured.
STUDIOFORGE_RUNTIME_PROVIDER=none

# Set only on the server. Never expose provider secrets with NEXT_PUBLIC_.
# STUDIOFORGE_RUNTIME_API_URL=
# STUDIOFORGE_RUNTIME_API_TOKEN=

# Configure a dedicated preview origin before enabling remote project execution.
# STUDIOFORGE_PREVIEW_BASE_URL=
